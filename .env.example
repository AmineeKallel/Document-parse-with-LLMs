# Copy this file to .env and replace the placeholder values with your real keys.
# cp .env.example .env

# OpenAI — used for pay slips, contracts, and handwritten invoices
OPEN_AI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter — used for regular PDF invoices (invoice.py)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — only if you expose the app with ngrok
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
